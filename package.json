{
  "name": "airlock-terminal",
  "version": "0.4.0",
  "description": "Chat-to-terminal airlock: a web chat and a real terminal in one window, with a scratchpad between them.",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node -e \"if(process.platform==='darwin')for(const a of['arm64','x64'])require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper',0o755)\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-ligatures": "0.10.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "repository": "github:ix9/AirlockTerminal",
  "build": {
    "appId": "io.github.ix9.airlockterminal",
    "productName": "Airlock Terminal",
    "artifactName": "AirlockTerminal-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "!src/assets/icon.svg",
      "package.json"
    ],
    "asarUnpack": [
      "src/shell-integration/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "src/assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "src/assets/icon.png"
    }
  }
}
